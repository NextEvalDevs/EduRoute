#!/usr/bin/env bash

set -e

STAGED_FILE=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|cpp|h|hpp)$' || true)

if [ -z "$STAGED_FILE" ]; then
    exit 0
fi


if command -v clang-format >/dev/null 2>&1; then
    echo "$STAGED_FILE" | xargs clang-format -i -style=file
    echo "$STAGED_FILE" | xargs git add
else
    echo "[pre-commit] clang-format failed"
fi

echo "[pre-commit] All checks passed"